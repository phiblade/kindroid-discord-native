# One dedicated bot, home room, and Kin. IDs are plain numeric Discord IDs (no #/@).
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_BOT_ID=your_bot_user_id
DISCORD_HOME_CHANNEL_ID=your_channel_id
KINDROID_AI_ID=your_native_kin_id
# Native API key from Kindroid Profile > Preferences > API & Integrations.
KINDROID_API_KEY=kn_your_native_api_key

# Keep the SQLite file and its journals on a persistent volume in production.
BRIDGE_DATABASE_PATH=data/native.sqlite
BRIDGE_ID=default
# Full batch budget INCLUDING envelope; 4000 is inferred from the chat limit.
KINDROID_MESSAGE_MAX_CHARS=4000
KINDROID_REQUEST_TIMEOUT_MS=180000
RETRY_BASE_MS=2000
RETRY_MAX_MS=60000
MAX_RECONCILE_CHECKS=5

# Compact transcript presentation (yes/no). Applied only to newly prepared batches.
CONTENT_PREPEND_MESSAGE_ID=no
CONTENT_PREPEND_DATE=no
CONTENT_PREPEND_TIME=yes
CONTENT_PREPEND_ROOM_LABEL=no
CONTENT_PREPEND_ROOM_ID=no
