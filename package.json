{
  "name": "kindroid-discord-native",
  "version": "1.0.1",
  "description": "Durable Discord home-room connector for the native Kindroid API",
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:native": "npm run build && node --test test/native.test.cjs test/ingestion.test.cjs test/transports.test.cjs test/presentation.test.cjs",
    "simulate:native": "npm run build && node dist/native/simulate.js",
    "ingest:native": "npm run build && node dist/native/ingest.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.cjs",
    "start:legacy": "npm run build && node dist/legacy-index.js"
  },
  "keywords": [
    "discord",
    "kindroid",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.57.1",
    "globals": "^15.14.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.9.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.23.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
